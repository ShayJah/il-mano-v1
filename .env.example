# Copy to .env for local `vercel dev` use. Never commit the real .env — in
# production these are set in the Vercel dashboard (Project → Settings → Environment Variables).

# Stripe secret key (server-side only). Use a test key (sk_test_...) until go-live is confirmed.
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret, from the Stripe Dashboard → Developers → Webhooks
# (or `stripe listen --print-secret` while testing locally).
STRIPE_WEBHOOK_SECRET=whsec_...

# Upstash Redis (Vercel Marketplace → Upstash → create a Redis database → REST API tab)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Shared secret required in the `x-admin-secret` header to call /api/capture-order.
# Generate one with: openssl rand -hex 32
CAPTURE_ADMIN_SECRET=change-me

# Resend (resend.com) — order-confirmation emails. Optional: if unset, checkout still
# works, it just won't send a confirmation email. Free tier: 100 emails/day.
RESEND_API_KEY=re_...
# Must be on a domain you've verified in Resend. Until you verify a domain, leave this
# unset — it falls back to onboarding@resend.dev, which only delivers to your own
# Resend account email (fine for testing, not for real customers).
ORDER_EMAIL_FROM=IL MANO <orders@yourdomain.com>

# Until ORDER_EMAIL_FROM is on a verified domain, onboarding@resend.dev can only deliver
# to your own Resend account email — not real customers. Set this to route every order
# confirmation to your own inbox instead (with reply-to set to the customer) so you don't
# lose notifications in the meantime. Remove once you've verified a sending domain.
ORDER_NOTIFY_EMAIL=you@yourdomain.com
